# Banco de dados PostgreSQL (ex.: Neon ou Supabase).
#
# DATABASE_URL          → conexão agrupada (pooled), usada pelo site.
# DATABASE_URL_UNPOOLED → conexão direta, usada pelas migrations.
#
# No Neon, as duas aparecem em Connect → Postgres database: a agrupada tem
# "-pooler" no endereço, a direta não. A integração Neon ↔ Vercel cria as
# duas sozinha, com exatamente estes nomes.
#
# Num PostgreSQL local, que não tem pooler, use o mesmo valor nas duas.
DATABASE_URL="postgresql://usuario:senha@host:5432/aurora?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/aurora?sslmode=require"

# Segredo para assinar a sessão do painel. Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-valor-longo-e-aleatorio"

# Acesso inicial da proprietária (usado apenas pelo comando de seed)
ADMIN_EMAIL="proprietaria@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Proprietária"

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"

# Armazenamento de fotos (Cloudinary — plano gratuito serve).
# Os três valores ficam no painel do Cloudinary, em Settings → API Keys.
# Sem eles, em desenvolvimento as fotos são salvas em public/uploads;
# em produção o envio de fotos é recusado com aviso claro.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Sinal via Pix automático (Mercado Pago) ───────────────────────────
#
# Sem estas variáveis o site funciona igual, só que com o Pix manual:
# a chave é exibida, a cliente avisa pelo WhatsApp e a proprietária
# confirma no painel. Com elas, o QR Code é gerado na hora e a reserva
# se confirma sozinha assim que o pagamento cai.
#
# MERCADOPAGO_ACCESS_TOKEN: credencial de produção, em
#   Seu negócio → Configurações → Gestão e administração → Credenciais.
#   Use as de teste enquanto estiver experimentando.
# MERCADOPAGO_WEBHOOK_SECRET: a "chave secreta" mostrada ao cadastrar a
#   notificação (webhook). Sem ela o site aceita o aviso sem conferir a
#   origem — continua seguro, porque o pagamento é reconsultado na API,
#   mas cadastre assim mesmo.
#
# Endereço a cadastrar no Mercado Pago, em Webhooks, evento "Pagamentos":
#   https://SEU-ENDERECO/api/pagamentos/mercadopago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ─── Avisos por e-mail (Brevo) ─────────────────────────────────────────
#
# Sem estas variáveis o site funciona igual, só que em silêncio: nenhum
# aviso de reserva nova, nenhum lembrete e nenhum alerta de erro.
#
# O Brevo foi escolhido porque aceita um endereço comum (Gmail) como
# remetente, sem exigir domínio próprio, e dá 300 envios por dia no plano
# gratuito. Confirme o remetente em Senders & IP antes de usar.
BREVO_API_KEY=""
EMAIL_REMETENTE=""            # precisa estar confirmado no Brevo
EMAIL_REMETENTE_NOME="Aurora Studio"
EMAIL_PROPRIETARIA=""         # para onde vão os avisos; vazio usa ADMIN_EMAIL

# ─── Página "Sistema" do painel ────────────────────────────────────────
#
# Quanto o plano do banco de dados oferece, em MB. A página Sistema usa
# este valor para dizer o quanto já foi usado. Sem a variável, ela supõe
# 512 MB — um teto conservador, que avisa cedo demais em vez de tarde.
# O número certo está no painel do Neon, em Billing/Usage: se for outro,
# cadastre aqui e a barra passa a bater com a realidade.
LIMITE_BANCO_MB=""

# Segredo da tarefa agendada que libera sinais vencidos e envia os
# lembretes da véspera. Gere um valor longo e aleatório.
CRON_SECRET=""
