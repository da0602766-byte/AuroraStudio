# Banco de dados PostgreSQL (ex.: Neon ou Supabase). Use a URL "pooled" em produção.
DATABASE_URL="postgresql://usuario:senha@host:5432/aurora?sslmode=require"

# Segredo para assinar a sessão do painel. Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-valor-longo-e-aleatorio"

# Acesso inicial da proprietária (usado apenas pelo comando de seed)
ADMIN_EMAIL="proprietaria@exemplo.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Proprietária"

# Endereço público do site (sem barra no final)
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"

# Armazenamento de fotos (Vercel Blob). Sem este valor, em desenvolvimento
# as fotos são salvas em public/uploads.
BLOB_READ_WRITE_TOKEN=""
